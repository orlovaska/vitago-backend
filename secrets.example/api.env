# Copy to secrets/api.env on the server and replace every change-me.
# Generate secrets with: openssl rand -base64 48
# The API refuses to start in production with weak or placeholder secrets.

DATABASE_URL=postgres://vitago:change-me@postgres:5432/vitago

# Changing it signs every device out once.
USER_JWT_SECRET=change-me
ADMIN_JWT_SECRET=change-me
# Changing it detaches every device from its account. Never change after launch.
DEVICE_SECRET_PEPPER=change-me

# T-Bank acquiring terminals by app slug.
TBANK_TERMINALS={"spb":{"terminalKey":"change-me","password":"change-me"}}
TBANK_TAXATION=usn_income
PAYMENT_NOTIFICATION_URL=https://api.vitagoguides.ru/v1/payments/tbank/notifications
PAYMENT_RETURN_BASE_URL=https://vitagoguides.ru

# Shared tour links (<site>/app/<slug>/tours/<tour>) and the absolute image in their preview.
PUBLIC_SITE_URL=https://vitagoguides.ru
PUBLIC_API_URL=https://api.vitagoguides.ru

# AppMetrica Post API by app slug; apps without an entry report nothing.
APPMETRICA_APPS={}

# Walking routing (deploy/routing). Areas by app slug; update-routing.sh reads them from here too.
VALHALLA_URL=http://valhalla:8002
ROUTING_REGIONS={"spb":{"sourcePbfUrl":"https://download.geofabrik.de/russia/northwestern-fed-district-latest.osm.pbf","bbox":{"minLon":29.4,"minLat":59.6,"maxLon":30.8,"maxLat":60.2}}}

LOG_LEVEL=info
