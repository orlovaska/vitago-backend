# Copy to .env for local development. Production values live on the server only.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://vitago:vitago@localhost:5432/vitago
LOG_LEVEL=debug
# LOG_DIR=logs

# Development-only values; production refuses anything this weak.
USER_JWT_SECRET=dev-user-jwt-secret-0000000000000000
ADMIN_JWT_SECRET=dev-admin-jwt-secret-000000000000000
DEVICE_SECRET_PEPPER=dev-device-pepper-00000000000000000

# Walking routing: Valhalla from deploy/routing (docker compose --profile routing).
VALHALLA_URL=http://localhost:8002
ROUTING_REGIONS={"spb":{"sourcePbfUrl":"https://download.geofabrik.de/russia/northwestern-fed-district-latest.osm.pbf","bbox":{"minLon":29.4,"minLat":59.6,"maxLon":30.8,"maxLat":60.2}}}
