# Copy to secrets/backup.env on the server. Used by scripts/backup-db.sh.
# rclone remote configured on the server (`rclone config`), e.g. a Google Drive.
BACKUP_RCLONE_REMOTE=gdrive
# Drive folder ids: the part after /folders/ in the folder URL.
BACKUP_DRIVE_FOLDER_ID=
# Weekly copies that are never deleted; empty turns them off.
BACKUP_DRIVE_ARCHIVE_FOLDER_ID=
# Hours between backups; 0 turns backups off.
BACKUP_INTERVAL_HOURS=6
# Dumps kept in the main folder.
BACKUP_KEEP=20
